{
  "extraKnownMarketplaces": {
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "enabledPlugins": {
    "variant-analysis@trailofbits": true,
    "sharp-edges@trailofbits": true,
    "insecure-defaults@trailofbits": true,
    "differential-review@trailofbits": true,
    "vulnerability-triage-brocards@trailofbits": true,
    "post-patch-validation@trailofbits": true,
    "document-skills@anthropic-agent-skills": true,
    "example-skills@anthropic-agent-skills": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skill_md_budget.py"
          }
        ]
      }
    ]
  }
}
